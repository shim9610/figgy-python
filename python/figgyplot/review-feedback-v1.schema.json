{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Figgyplot review feedback protocol 1",
  "type": "object",
  "required": [
    "protocol",
    "session_id",
    "round"
  ],
  "properties": {
    "protocol": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "object",
      "required": [
        "id",
        "number",
        "status",
        "source",
        "documents",
        "work_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "const": "ready"
        },
        "work_id": {
          "type": "string"
        },
        "intent": {
          "enum": [
            "revise",
            "finish"
          ]
        },
        "source": {
          "type": "object"
        },
        "documents": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/document"
          }
        }
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": [
        "baseline",
        "baseline_revision",
        "baseline_hash",
        "dpi",
        "backend",
        "columns",
        "comments",
        "approval"
      ],
      "properties": {
        "baseline": {
          "type": "object"
        },
        "baseline_revision": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "columns": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/binary"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "target"
            ],
            "properties": {
              "channel": {
                "enum": [
                  "api",
                  "ui",
                  "ui_target"
                ]
              },
              "text": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "target": {}
            }
          }
        },
        "approval": {
          "type": "object",
          "required": [
            "id",
            "disposition",
            "revision",
            "settings",
            "persistent_hash",
            "changes"
          ],
          "properties": {
            "disposition": {
              "enum": [
                "accept",
                "request_changes",
                "skip"
              ]
            },
            "changes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/change"
              }
            }
          }
        }
      }
    },
    "binary": {
      "type": "object",
      "required": [
        "file",
        "sha256",
        "bytes",
        "dtype",
        "shape"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^data/[0-9a-f]{64}\\.npy$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "dtype": {
          "type": "string"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "change": {
      "type": "object",
      "required": [
        "id",
        "op",
        "path",
        "object_id",
        "selectors",
        "before_exists",
        "after_exists",
        "before",
        "after"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "op": {
          "enum": [
            "add",
            "remove",
            "replace",
            "move"
          ]
        },
        "path": {
          "type": "string"
        },
        "object_id": {
          "type": "string"
        },
        "selectors": {
          "type": "object"
        },
        "before_exists": {
          "type": "boolean"
        },
        "after_exists": {
          "type": "boolean"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "event": {
      "type": "object",
      "required": [
        "protocol",
        "session_id",
        "round_id",
        "work_id",
        "manifest",
        "source"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "round_id": {
          "type": "string",
          "minLength": 1
        },
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "enum": [
            "revise",
            "finish"
          ]
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object"
        }
      }
    },
    "preview": {
      "type": "object",
      "required": [
        "value",
        "truncated"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "summary_property": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "before_exists",
        "after_exists",
        "before",
        "after",
        "operation_ids"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "rich_text",
            "add",
            "remove",
            "replace",
            "move"
          ]
        },
        "before_exists": {
          "type": "boolean"
        },
        "after_exists": {
          "type": "boolean"
        },
        "before": {
          "$ref": "#/$defs/preview"
        },
        "after": {
          "$ref": "#/$defs/preview"
        },
        "operation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "text_changed": {
          "type": "boolean"
        },
        "formatting_changed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "detail_selector": {
      "type": "object",
      "required": [
        "figure_id"
      ],
      "properties": {
        "figure_id": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "summary_object": {
      "type": "object",
      "required": [
        "target",
        "label",
        "scope",
        "change_count",
        "properties",
        "comments",
        "details",
        "label_truncated"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "change_count": {
          "type": "integer",
          "minimum": 0
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary_property"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "target",
              "channel"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "channel": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "details": {
          "$ref": "#/$defs/detail_selector"
        },
        "label_truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "detail_object": {
      "type": "object",
      "required": [
        "target",
        "label",
        "scope",
        "change_count",
        "properties",
        "comments",
        "details",
        "snapshots",
        "label_truncated"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "change_count": {
          "type": "integer",
          "minimum": 0
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary_property"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "target",
              "channel"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "channel": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "details": {
          "$ref": "#/$defs/detail_selector"
        },
        "snapshots": {
          "type": "object",
          "required": [
            "before",
            "after"
          ],
          "properties": {
            "before": {
              "type": "object"
            },
            "after": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "label_truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "summary_figure": {
      "type": "object",
      "required": [
        "id",
        "disposition",
        "intent",
        "change_count",
        "comment_count",
        "comments",
        "objects",
        "details",
        "data_changed"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "disposition": {
          "enum": [
            "accept",
            "request_changes",
            "skip"
          ]
        },
        "intent": {
          "enum": [
            "revise",
            "finish"
          ]
        },
        "change_count": {
          "type": "integer",
          "minimum": 0
        },
        "comment_count": {
          "type": "integer",
          "minimum": 0
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "target",
              "channel"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "channel": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary_object"
          }
        },
        "details": {
          "$ref": "#/$defs/detail_selector"
        },
        "data_changed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "protocol",
        "view",
        "session_id",
        "round_id",
        "work_id",
        "intent",
        "source",
        "figures",
        "counts"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "view": {
          "const": "summary"
        },
        "session_id": {
          "type": "string"
        },
        "round_id": {
          "type": "string"
        },
        "work_id": {
          "type": "string"
        },
        "intent": {
          "enum": [
            "revise",
            "finish"
          ]
        },
        "source": {
          "type": "object"
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary_figure"
          }
        },
        "counts": {
          "type": "object",
          "required": [
            "figures",
            "objects",
            "changes",
            "comments"
          ],
          "properties": {
            "figures": {
              "type": "integer",
              "minimum": 0
            },
            "objects": {
              "type": "integer",
              "minimum": 0
            },
            "changes": {
              "type": "integer",
              "minimum": 0
            },
            "comments": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "details": {
      "type": "object",
      "required": [
        "protocol",
        "view",
        "session_id",
        "round_id",
        "work_id",
        "figure_id",
        "comments",
        "objects",
        "selection",
        "changes"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "view": {
          "const": "details"
        },
        "session_id": {
          "type": "string"
        },
        "round_id": {
          "type": "string"
        },
        "work_id": {
          "type": "string"
        },
        "figure_id": {
          "type": "string"
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "target",
              "channel"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "channel": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detail_object"
          }
        },
        "selection": {
          "type": "object",
          "required": [
            "target",
            "change_id"
          ],
          "properties": {
            "target": {
              "type": [
                "string",
                "null"
              ]
            },
            "change_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
